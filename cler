tokens = clore_lexer(clre_source_code)
parser = CloreParser(tokens)
ast = parser.parse()
compiler = CloreCompiler(ast)
ir = compiler.compile_to_ir()

runtime = ClreRuntimeEngine(ir)
runtime.boot()
